# Copy this file to .env and replace all development placeholders.
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
DB_USERNAME=swpu
DB_PASSWORD=replace_with_a_local_database_password

GATEWAY_PORT=8080
MOCK_AGENT_PORT=8000
AGENT_BASE_URL=http://mock-agent:8000

# Generate a Base64-encoded random value containing at least 32 bytes.
JWT_SECRET_KEY=replace_with_a_strong_base64_secret

AGENT_CONNECT_TIMEOUT_MS=10000
AGENT_READ_TIMEOUT_MS=120000
AGENT_SSE_STREAM_TIMEOUT_MS=120000
AGENT_SSE_JSON_TIMEOUT_MS=60000
